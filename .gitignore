infra/charts/cvat/charts/
infra/charts/postgresql/charts/*.tgz

# Model / weight blobs (ADR-014 D5: weights live in S3 or the model registry)
*.onnx
*.pth
*.safetensors
*.gguf
*.pdparams

# Backup / scratch and generated notebook compiler output
*.bak
/.scratch/
/app/python-backend/out/

k3s.yaml

# Pre-baked pretrained weights baked into trainer images (large binaries, fetch
# on demand with scripts in app/builders/trainer-torch/cache/)
app/builders/trainer-torch/cache/

# Local build/runtime artifacts (never ship)
app/builders/sdk/build/
app/builders/ml-backend/cache.db
app/builders/ml-backend/vendor/**/build/
app/builders/ml-backend/vendor/**/*.egg-info/

# Optional local build acceleration fragment (treaty §19.3); see
# local.mk.example for the supported empty-valued variables.
/local.mk

# Local Helm chart packaging output from `make helm-package`.
/charts-packaged/
