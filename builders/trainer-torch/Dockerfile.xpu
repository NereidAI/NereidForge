# Copyright (C) 2026 YIQISOFT
# SPDX-License-Identifier: Apache-2.0

# NereidForge vision trainer — Intel XPU (per-vendor image, ADR-012/014).
#
# xpu-base provides torch 2.14+xpu in the /opt/xpu venv (on PATH) and NEO 26.
# torchvision MUST match torch exactly and install --no-deps: the default index
# serves a CUDA/CPU build that breaks with "operator torchvision::nms does not
# exist" on XPU.
# Tag-sourced model (root treaty §19.5): release builds pass the bare SemVer
# explicitly; the 0.0.0-dev default covers non-tag local builds.
ARG BASE_IMAGE=ghcr.io/nereidai/trainer-xpu-base:0.0.0-dev
FROM ${BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='trainer-torch-xpu' \
      org.opencontainers.image.description='Intel XPU PyTorch vision training and model export for NereidForge.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ARG TORCH_XPU_INDEX=""
ARG TORCHVISION_VERSION=0.29.0+xpu
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

ARG TORCH_VERSION=2.14.0
# Pin the +xpu torch/torchvision in a constraints file: without it, pip's
# resolver happily REPLACES torch+xpu (pulled by timm/smp deps) with the
# plain CUDA manylinux wheel from the default index (pit 49 class); the
# installed +xpu build already satisfies the constraint, so pip leaves it.
RUN if [ -z "$TORCH_XPU_INDEX" ]; then \
        echo "ERROR: TORCH_XPU_INDEX is required for +xpu wheels" >&2; exit 1; \
    fi; \
    echo "torch==${TORCH_VERSION}+xpu" > /tmp/xpu-constraints.txt \
    && echo "torchvision==${TORCHVISION_VERSION}" >> /tmp/xpu-constraints.txt \
    && pip install --no-cache-dir --no-deps --timeout 120 --retries 10 \
        --index-url "${TORCH_XPU_INDEX}" \
        "torchvision==${TORCHVISION_VERSION}" \
    && pip install --no-cache-dir --timeout 120 --retries 10 \
        -c /tmp/xpu-constraints.txt \
        "timm>=1.0" "segmentation-models-pytorch>=0.3" \
        "numpy<2.3" "pillow>=10.0" "pyyaml>=6.0" "boto3>=1.34" \
        "onnx>=1.14,<2" "onnxruntime>=1.17" \
    && rm -f /tmp/xpu-constraints.txt \
    && python -c "import torch, torchvision; \
        assert '+xpu' in torch.__version__, torch.__version__; \
        assert '+xpu' in torchvision.__version__, torchvision.__version__; \
        print('xpu torch verified:', torch.__version__, torchvision.__version__)"

ENV NF_DEVICE=xpu
# The SDK is the only shared contract (ADR-016); the build context is
# builders so the package and the trainer sources ship together.
COPY sdk /opt/nf-trainer-sdk
RUN pip install --no-cache-dir /opt/nf-trainer-sdk && rm -rf /opt/nf-trainer-sdk
COPY trainer-torch/common.py trainer-torch/dataset.py trainer-torch/models.py \
     trainer-torch/metrics.py trainer-torch/train.py trainer-torch/evaluate.py \
     trainer-torch/export.py trainer-torch/catalog.py trainer-torch/nf_profile.py \
     trainer-torch/trainer-profile.json /app/
# Pre-baked torchvision COCO weights: the upstream download host is slow
# (~35 kB/s) or unreachable in regional/offline sites, and run-time
# downloads hang pod startup.
# Filenames carry the torchvision sha256 prefix; load_state_dict_from_url()
# verifies them and skips the download when present.
COPY trainer-torch/cache/torch/hub/checkpoints/ /root/.cache/torch/hub/checkpoints/
WORKDIR /app

ENTRYPOINT ["sh", "-c", "case \"${SCRIPT:-train}\" in evaluate) exec python /app/evaluate.py;; export) exec python /app/export.py;; catalog) exec python /app/catalog.py;; profile) exec python /app/nf_profile.py;; *) exec python /app/train.py;; esac"]
