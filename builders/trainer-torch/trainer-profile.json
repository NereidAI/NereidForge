          "license": "BSD-3-Clause"
        },
        {
          "id": "deeplabv3_resnet50",
          "label": "DeepLabV3 (ResNet-50)",
          "size": 512,
          "params_m": 39.6,
          "tier": "core",
          "license": "BSD-3-Clause"
        },
