    {
      "id": "detection",
      "label": "Object detection",
      "tier": "core",
      "default_arch": "fasterrcnn_mobilenet_v3_large_fpn",
      "architectures": [
        {
          "id": "fasterrcnn_mobilenet_v3_large_fpn",
          "label": "Faster R-CNN (MobileNetV3)",
          "size": 640,
          "params_m": 19.3,
          "tier": "core",
          "license": "BSD-3-Clause"
