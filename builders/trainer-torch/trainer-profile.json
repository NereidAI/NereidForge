          "id": "fcn_resnet50",
          "label": "FCN (ResNet-50)",
          "size": 512,
          "params_m": 35.3,
          "tier": "core",
          "license": "BSD-3-Clause"
        },
        {
          "id": "lraspp_mobilenet_v3_large",
          "label": "LR-ASPP (MobileNetV3)",
          "size": 512,
          "params_m": 3.2,
          "tier": "core",
          "license": "BSD-3-Clause"
        }
      ]
    },
    {
      "id": "pose",
      "label": "Pose / keypoints",
      "tier": "core",
      "default_arch": "keypointrcnn_resnet50_fpn",
      "architectures": [
        {
          "id": "keypointrcnn_resnet50_fpn",
          "label": "Keypoint R-CNN (ResNet-50)",
          "size": 640,
          "params_m": 59.0,
          "tier": "core",
          "license": "BSD-3-Clause"
        }
      ]
    }
  ],
  "capabilities": [
    {
      "id": "export.onnx",
      "label": "ONNX export",
      "tier": "core",
      "entrypoint": "export"
    },
    {
      "id": "optimization.tensorrt",
      "label": "TensorRT optimisation (INT8/FP16)",
      "tier": "extended",
      "requires": [
        "extended.optimization"
      ],
      "entrypoint": "optimize"
    }
  ],
  "entrypoints": {
    "train": "python /app/train.py",
    "evaluate": "python /app/evaluate.py",
    "export": "python /app/export.py",
    "catalog": "python /app/catalog.py",
    "profile": "python /app/nf_profile.py"
  },
  "env": [
    "INPUT_URI",
    "OUTPUT_DIR",
    "CONFIG_JSON",
    "ARTIFACT_ID"
  ],
  "artifacts": [
    "<id>.onnx",
    "<id>.metadata.json",
    "<id>.metrics.json",
    "<id>.pt"
  ],
  "config_schema": {
    "task": {
      "type": "string",
      "enum": [
        "classification",
        "multilabel",
        "detection",
        "instance_seg",
        "semantic_seg",
        "pose"
      ]
    },
    "model": {
      "type": "string"
    },
    "epochs": {
      "type": "integer",
      "default": 50
    },
    "batch": {
      "type": "integer",
      "default": 16
    },
    "workers": {
      "type": "integer",
      "minimum": 0,
      "default": 2
    },
    "image_size": {
      "type": "integer"
    },
    "learning_rate": {
      "type": "number"
    },
    "base_weights_uri": {
      "type": "string"
    },
    "freeze_backbone": {
      "type": "boolean",
      "default": false
    }
  },
  "license": {
    "code": "Apache-2.0",
    "weights": "per-model"
  }
}
