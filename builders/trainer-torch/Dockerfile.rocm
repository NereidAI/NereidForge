# Copyright (C) 2026 YIQISOFT
# SPDX-License-Identifier: Apache-2.0

# NereidForge vision trainer — AMD ROCm (per-vendor image, ADR-012/014).
#
# torch.cuda is HIP on ROCm, so the trainer's `cuda` device path is unchanged.
# The ROCm userspace base is the only input not served by the regional
# mirror: mirror it first (upstream tag
# rocm/pytorch:rocm6.3_ubuntu24.04_py3.12_pytorch_release_2.4.0, retagged to
# hub.../rocm/pytorch:rocm6.3). torch/torchvision are force-reinstalled from
# the injected ROCm 6.3 wheel index (TORCH_ROCM_INDEX) to track torch 2.9.1
# (wheels ship their own userspace and stay ABI-compatible with the 6.3
# base/kernel driver).
ARG BASE_IMAGE=rocm/pytorch:rocm6.3_ubuntu24.04_py3.12_pytorch_release_2.4.0
FROM ${BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='trainer-torch-rocm' \
      org.opencontainers.image.description='AMD ROCm PyTorch vision training and model export for NereidForge.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

# Build network endpoints injected at build time for regional networks;
# empty values reproduce pristine upstream behavior. The ROCm wheels only
# exist on the specialized wheel index, so an empty TORCH_ROCM_INDEX means
# the caller must inject one.
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ARG APT_MIRROR=""
ARG TORCH_ROCM_INDEX=""
ARG TORCH_VERSION=2.9.1
ARG TORCHVISION_VERSION=0.24.1
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
ENV PYTHONUNBUFFERED=1

RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s@//.*archive.ubuntu.com@//$APT_MIRROR@g; s@//security.ubuntu.com@//$APT_MIRROR@g" \
            /etc/apt/sources.list /etc/apt/sources.list.d/ubuntu.sources 2>/dev/null || true; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

RUN if [ -z "$TORCH_ROCM_INDEX" ]; then \
        echo "ERROR: TORCH_ROCM_INDEX is required for +rocm6.3 wheels" >&2; exit 1; \
    fi; \
    pip install --no-cache-dir --force-reinstall --timeout 120 --retries 10 \
        --index-url "${TORCH_ROCM_INDEX}" \
        "torch==${TORCH_VERSION}+rocm6.3" "torchvision==${TORCHVISION_VERSION}+rocm6.3" \
    && python -c "import torch, torchvision; \
        assert '+rocm6.3' in torch.__version__, torch.__version__; \
        assert '+rocm6.3' in torchvision.__version__, torchvision.__version__; \
        assert torch.version.hip is not None; \
        print('ROCm torch verified:', torch.__version__, torchvision.__version__)" \
    && pip install --no-cache-dir --timeout 120 --retries 10 \
        "timm>=1.0" "segmentation-models-pytorch>=0.3" \
        "numpy<2.3" "pillow>=10.0" "pyyaml>=6.0" "boto3>=1.34" \
        "onnx>=1.14,<2" "onnxruntime>=1.17"

ENV NF_DEVICE=rocm
# The SDK is the only shared contract (ADR-016); the build context is
# builders so the package and the trainer sources ship together.
COPY sdk /opt/nf-trainer-sdk
RUN pip install --no-cache-dir /opt/nf-trainer-sdk && rm -rf /opt/nf-trainer-sdk
COPY trainer-torch/common.py trainer-torch/dataset.py trainer-torch/models.py \
     trainer-torch/metrics.py trainer-torch/train.py trainer-torch/evaluate.py \
     trainer-torch/export.py trainer-torch/catalog.py trainer-torch/nf_profile.py \
     trainer-torch/trainer-profile.json /app/
WORKDIR /app

ENTRYPOINT ["sh", "-c", "case \"${SCRIPT:-train}\" in evaluate) exec python /app/evaluate.py;; export) exec python /app/export.py;; catalog) exec python /app/catalog.py;; profile) exec python /app/nf_profile.py;; *) exec python /app/train.py;; esac"]
