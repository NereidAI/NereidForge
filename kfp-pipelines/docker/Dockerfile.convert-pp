# NereidForge PaddlePaddle -> ONNX conversion image.
# Context MUST be kfp-pipelines/docker.
#
# One image per converter family (per-vendor separation iron rule): Paddle
# inference models never touch the torch convert image. Exports
# <name>.pdmodel (+ sibling <name>.pdiparams) via paddle2onnx. Fully
# self-contained: paddlepaddle CPU, paddle2onnx, onnx and boto3 are baked in;
# the component never performs a runtime network fetch.
# PaddlePaddle 3.0.0 and its NumPy<2 dependency set have no stable cp314
# wheels; retain the user-required Python 3.11 compatibility pin. Suite-wide
# treaty registration of this converter exception remains a tracked follow-up.
ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='trainer-convert-pp' \
      org.opencontainers.image.description='PaddlePaddle to ONNX conversion runtime for NereidForge pipelines.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
# Regional apt mirror injected at build time; empty keeps upstream apt sources.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s@//deb.debian.org@//$APT_MIRROR@g; s@//security.debian.org@//$APT_MIRROR@g" \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; fi
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
# PaddlePaddle CPU + the ONNX exporter. paddle2onnx is maintained by the
# Paddle team and accepts the inference-model .pdmodel/.pdiparams pair.
# Its default optimizer is polygraphy: bake its constant-folding deps
# (onnx_graphsurgeon, sympy, colored) AND onnxruntime 1.17.x, the last line
# that ships onnxruntime.tools.symbolic_shape_infer (removed in ort 1.18+);
# with newer ort polygraphy silently `pip install`s an older onnxruntime at
# runtime -- forbidden offline. POLYGRAPHY_AUTOINSTALL_DEPS=0 makes any
# unforeseen missing dep fail loudly instead of reaching the network.
ENV POLYGRAPHY_AUTOINSTALL_DEPS=0
RUN pip install --no-cache-dir --retries 5 \
    "paddlepaddle==3.0.0" "numpy<2" \
    "paddle2onnx>=1.3.0" "onnx>=1.14.0" "onnxruntime==1.17.3" \
    "onnx-graphsurgeon>=0.3.27" "sympy" "colored" \
    "boto3>=1.34.0" "botocore>=1.34.0"
WORKDIR /app
ENTRYPOINT ["python"]
