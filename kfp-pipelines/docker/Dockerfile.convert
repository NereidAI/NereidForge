# NereidForge PyTorch/custom model conversion image. The context MUST be
# kfp-pipelines/docker. Paddle and TensorFlow artifacts use their dedicated
# converter images so no framework stack crosses the per-vendor boundary.
#
# The image is self-contained for offline conversion: torch, torchvision, ONNX
# tooling and the S3 client are baked in. AGPL-licensed Ultralytics and the
# removed YOLOv5/v6/v7 source trees are deliberately not packaged.
ARG PYTHON_BASE_IMAGE=python:3.14-slim
FROM ${PYTHON_BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='trainer-convert' \
      org.opencontainers.image.description='PyTorch and custom model conversion runtime for NereidForge pipelines.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
# Regional apt mirror injected at build time; empty keeps upstream apt sources.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s@//deb.debian.org@//$APT_MIRROR@g; s@//security.debian.org@//$APT_MIRROR@g" \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; fi
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
# The injected CPU wheel index selects CPU-only wheels. With no index, pip
# uses its pristine default and resolves the corresponding public packages.
ARG TORCH_CPU_INDEX=""
RUN if [ -n "$TORCH_CPU_INDEX" ]; then \
        pip install --no-cache-dir \
            --index-url "${TORCH_CPU_INDEX}" \
            torch==2.14.0+cpu torchvision==0.29.0+cpu; \
    else \
        pip install --no-cache-dir \
            torch==2.14.0 torchvision==0.29.0; \
    fi
# ONNX export dependencies are installed here because lightweight KFP
# components must never fetch packages at run time in an air-gapped deployment.
RUN pip install --no-cache-dir \
    "onnx>=1.14.0" "onnxruntime>=1.17.0" "onnxslim>=0.1.0" "onnxscript" \
    "boto3>=1.34.0" "botocore>=1.34.0" \
    "tqdm>=4.41.0" "seaborn>=0.11.0" "scipy>=1.4.1"
# KFP injects the compiled convert_step body at run time; only its runtime
# dependencies belong in this image.
WORKDIR /app
ENTRYPOINT ["python"]
