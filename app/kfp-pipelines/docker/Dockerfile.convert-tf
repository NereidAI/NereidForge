# NereidForge TensorFlow/Keras -> ONNX conversion image.
# Context MUST be app/kfp-pipelines/docker.
#
# One image per converter family (per-vendor separation iron rule): TF/Keras
# weights never touch the torch convert image. Supports modern Keras v3 files
# (.keras), legacy HDF5 models (.h5) and SavedModel directory bundles (.zip)
# via tf2onnx. Fully self-contained: one TensorFlow CPU runtime, tf2onnx, ONNX
# and boto3 are baked in; the component never performs a runtime network fetch.
# TensorFlow 2.18, tf-keras and the pinned ONNX Runtime lack stable cp314
# wheels; retain the user-required Python 3.11 compatibility pin. Suite-wide
# treaty registration of this converter exception remains a tracked follow-up.
ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='trainer-convert-tf' \
      org.opencontainers.image.description='TensorFlow and Keras to ONNX conversion runtime for NereidForge pipelines.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

ARG TARGETARCH
ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
ENV PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
# Regional apt mirror injected at build time; empty keeps upstream apt sources.
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then sed -i "s@//deb.debian.org@//$APT_MIRROR@g; s@//security.debian.org@//$APT_MIRROR@g" \
        /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; fi
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
# TensorFlow CPU + the ONNX exporter. onnx/onnxruntime are pinned to versions
# compatible with tensorflow 2.18's ml-dtypes~=0.4 pin (onnx>=1.18 requires
# ml_dtypes.float4 which 0.4 lacks); numpy kept <2.1 for the tf 2.18 ABI.
# tf-keras (Keras 2) is needed to load legacy .h5 models under Keras 3; the
# component imports it explicitly (TF_USE_LEGACY_KERAS is NOT forced, so
# modern .keras files still load with native Keras 3).
# tensorflow-cpu publishes Linux wheels only for AMD64; the full tensorflow
# distribution supplies the ARM64 CPU runtime. Select exactly one per target.
# tf-keras names the full tensorflow distribution in its metadata, so install
# it without dependencies on both architectures to prevent a second TensorFlow.
RUN set -eux; \
    case "$TARGETARCH" in \
        amd64) tensorflow_dist="tensorflow-cpu" ;; \
        arm64) tensorflow_dist="tensorflow" ;; \
        *) echo "Unsupported TensorFlow converter architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    pip install --no-cache-dir --retries 5 \
        "${tensorflow_dist}==2.18.0" "numpy<2.1" \
        "tf2onnx>=1.16.0" "onnx==1.17.0" "onnxruntime==1.20.1" \
        "boto3>=1.34.0" "botocore>=1.34.0"; \
    pip install --no-cache-dir --retries 5 --no-deps "tf-keras==2.18.0"; \
    TF_DISTRIBUTION="$tensorflow_dist" python -c 'import importlib.metadata as metadata, os, tensorflow as tf, tf_keras; \
        expected = os.environ["TF_DISTRIBUTION"]; \
        installed = {dist.metadata["Name"].lower() for dist in metadata.distributions()}; \
        other = ({"tensorflow", "tensorflow-cpu"} - {expected}).pop(); \
        assert metadata.version(expected) == "2.18.0"; \
        assert other not in installed, (expected, other); \
        assert tf.__version__ == "2.18.0", tf.__version__; \
        assert tf_keras.__version__ == "2.18.0", tf_keras.__version__; \
        print("TensorFlow CPU verified:", expected, tf.__version__, tf_keras.__version__)'
WORKDIR /app
ENTRYPOINT ["python"]
