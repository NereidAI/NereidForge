# Legacy shared component runtime; the public base remains locally overridable.
ARG PYTHON_BASE_IMAGE=python:3.14-slim
FROM ${PYTHON_BASE_IMAGE}
ARG VERSION=0.0.0-dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=""
LABEL license='SPDX-License-Identifier: Apache-2.0' \
      copyright='Copyright (c) 2026: YIQISOFT' \
      org.opencontainers.image.title='nf-runtime' \
      org.opencontainers.image.description='Shared Kubeflow Pipelines component runtime for NereidForge.' \
      org.opencontainers.image.vendor='YIQISOFT' \
      org.opencontainers.image.licenses='Apache-2.0' \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.url='https://github.com/NereidAI/NereidForge' \
      org.opencontainers.image.documentation='https://github.com/NereidAI/NereidForge#readme' \
      org.opencontainers.image.authors='NereidAI (https://github.com/NereidAI)'
COPY LICENSE NOTICE /licenses/

ARG PIP_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
# Injected at build time for regional networks; empty uses pip's default index.
ENV PIP_INDEX_URL=${PIP_INDEX_URL} PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}
# kfp is required: KFP v2 launches a lightweight component with a wrapper that
# pip-installs `kfp==2.17.0 --no-deps` at run time, so the full kfp dependency
# closure (docstring-parser, kfp-pipeline-spec, ...) MUST already be present in
# this base. Without it `python -m kfp.dsl.executor_main` fails to import and
# every component (dataset_step/train_step) exits 255 before running. See pit 76.
RUN pip install --no-cache-dir \
    "kfp==2.17.0" \
    "requests>=2.31.0" "pydantic>=2.5.0" "tenacity>=8.2.0" "numpy>=1.24.0" \
    "boto3>=1.34.0" "botocore>=1.34.0" "opencv-python-headless>=4.8.0" \
    "kubernetes>=30.0.0" "pyyaml>=6.0" "onnxruntime>=1.16.0" "onnx>=1.14.0" "gguf>=0.5.0"
