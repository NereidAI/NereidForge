-  # NOTE: CI test reporting reads this Secret name to fetch MinIO credentials for AWF log enrichment.
-  # If you rename it, also update:
-  # backend/test/testutil/archived_workflow_logs.go
+  # KFP apiserver / UI / profile-controller read these keys to talk to S3.
+  # Installers inject the operator-managed SeaweedFS credentials.

