# NereidForge secrets template
# Copy to secrets.yaml and fill in the real values.
# Every value is substituted from environment variables by envsubst.

postgresql:
  admin_password: "${PG_ADMIN_PASSWORD}"

# Valkey (Label Studio / CVAT cache) runs without a password inside the cluster.
seaweedfs:
  s3_access_key: "${SEAWEEDFS_S3_ACCESS_KEY}"
  s3_secret_key: "${SEAWEEDFS_S3_SECRET_KEY}"

labelstudio:
  token: "${LABEL_STUDIO_TOKEN}"

cvat:
  token: "${CVAT_TOKEN}"

auth:
  jwt_secret: "${JWT_SECRET}"
  dex_static_password_hash: "${DEX_STATIC_PASSWORD_HASH}"

# Registry pull secrets are intentionally absent here. Default installs use
# public image coordinates with anonymous pull. On an air-gapped site,
# provision the pull secret out of band via REGISTRY_HOST / REGISTRY_USER /
# REGISTRY_PASS (see infra/scripts/02_load-offline/prepare-secrets.sh); no
# registry hostname is ever committed to this repository.
